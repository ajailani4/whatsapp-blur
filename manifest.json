{
  "manifest_version": 3,
  "name": "WhatsApp Blur",
  "version": "1.0.0",
  "description": "Blur WhatsApp Web messages, names, previews and photos for privacy. Hover to reveal.",
  "permissions": ["storage"],
  "action": {
    "default_title": "WhatsApp Blur",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
